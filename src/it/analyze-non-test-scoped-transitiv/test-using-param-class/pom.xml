<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.maven.its.dependency</groupId>
    <artifactId>test-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>test-using-param-class</artifactId>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>direct-dep</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
       On COMPILE scope transitive-dep is not used directly but is required.
       On TEST scope transitive-dep is used directly.
       A class from the transitive-dep is present in constant pool as part of a method signature but not as reference.
       If we add the transitive-dep hier with TEST scope, then it will be "removed" from COMPILE scope and will cause compile errors.
       If we add the transitive-dep hier with COMPILE scope, then the project will have potential problem: 
       - if we update version of direct-dep, then we must check and update also the version of transitive-dep
       - otherwise we could downgrade the version of transitive-dep that could cause (runtime) problems. 
     -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.shared.dependency-analyzer.tests</groupId>
        <artifactId>maven-mock-plugin</artifactId>
        <version>1.0</version>
        <executions>
          <execution>
            <goals>
              <goal>mock-analyze</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>